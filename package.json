{
  "name": "hourforge",
  "version": "0.1.2",
  "license": "Apache-2.0",
  "private": true,
  "description": "Autonomous Steam playtime keeper and humanized scheduler",
  "author": "Arnav Sharma",
  "homepage": "https://github.com/nxtArnav-sharma/Hour-Forge",
  "repository": {
    "type": "git",
    "url": "https://github.com/nxtArnav-sharma/Hour-Forge.git"
  },
  "bugs": {
    "url": "https://github.com/nxtArnav-sharma/Hour-Forge/issues"
  },
  "main": "dist/main/index.js",
  "scripts": {
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "build:main": "vite build --config vite.main.config.ts && node -e \"require('fs').copyFileSync('src/main/steam/steamHelper.js', 'dist/main/steamHelper.js')\" && node -e \"require('fs').cpSync('build/tray', 'dist/main/tray', { recursive: true })\"",
    "build:preload": "vite build --config vite.preload.config.ts",
    "build:renderer": "vite build --config vite.renderer.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.hourforge.app",
    "productName": "HourForge",
    "copyright": "Copyright © 2026 Arnav Sharma",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "dist/main/steamHelper.js",
      "node_modules/steamworks.js/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "HourForge",
      "artifactName": "HourForge-Setup-${version}.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeader": "build/installerHeader.bmp",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "include": "build/installer.nsh"
    }
  },
  "dependencies": {
    "@xhayper/discord-rpc": "1.5.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.4.7",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.1",
    "steamworks.js": "^0.4.0",
    "tailwind-merge": "^3.0.1",
    "ws": "^8.18.0",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.5.14",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vitest": "^3.0.5"
  }
}
